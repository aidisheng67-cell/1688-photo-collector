# 复制为 .env 后填写；.env 已被 .gitignore 排除。
# 环境变量优先级高于 config.yaml，适合 CI / Docker / 服务器部署。
# 本文件只列变量名和占位值，不要提交真实密钥。

# ---- onebound 图片搜索 ----
ONEBOUND_BASE_URL=https://api-gw.onebound.cn
ONEBOUND_API_KEY=your-api-key
ONEBOUND_API_SECRET=your-api-secret

# ---- 钉钉在线表格 ----
DINGTALK_APP_KEY=your-app-key
DINGTALK_APP_SECRET=your-app-secret
DINGTALK_WORKBOOK_ID=your-workbook-id
DINGTALK_SHEET_ID=your-sheet-id
DINGTALK_OPERATOR_ID=your-union-id

# ---- 飞书多维表格 ----
FEISHU_APP_ID=your-app-id
FEISHU_APP_SECRET=your-app-secret
FEISHU_APP_TOKEN=your-app-token
FEISHU_TABLE_ID=your-table-id

# ---- 金山文档 ----
WPS_APP_ID=your-app-id
WPS_APP_SECRET=your-app-secret
WPS_ACCESS_TOKEN=your-access-token
WPS_FILE_TOKEN=your-file-token

# ---- 路径（Docker / 服务器建议用绝对路径）----
# COLLECTOR_CONFIG=/app/config/config.yaml
# COLLECTOR_OUTPUT=/data/output
# COLLECTOR_WORK=/data/work
# COLLECTOR_CACHE=/data/cache/cache.sqlite
# COLLECTOR_LOG=/data/logs
# COLLECTOR_REVIEW=/data/review

# 可选：允许 save_config 把密钥写回 config.yaml（默认不写）
# COLLECTOR_PERSIST_SECRETS=1
